{
  "name": "Daymark — Small marks, lasting rhythm",
  "short_name": "Daymark",
  "description": "A warm, calm, local-first daily habit tracker, wellness check-in, and micro-journal with optional cross-device sync.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F6F2EA",
